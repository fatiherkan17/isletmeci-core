generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  image       String?
  active      Boolean  @default(true)
  available   Boolean  @default(true)
  featured    Boolean  @default(false)
  sortOrder   Int      @default(0)
  categoryId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category   Category    @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
}

model Setting {
  id           String   @id @default(cuid())
  businessName String
  slogan       String?
  logo         String?
  phone        String?
  address      String?
  instagram    String?
  workingHours String?
  menuUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(STAFF)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  permissions UserPermission[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  users UserPermission[]
}

model UserPermission {
  id           String @id @default(cuid())
  userId       String
  permissionId String

  createdAt DateTime @default(now())

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model Table {
  id        String      @id @default(cuid())
  number    Int         @unique
  name      String
  capacity  Int         @default(4)
  status    TableStatus @default(EMPTY)
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  orders Order[]
}

model Order {
  id      String @id @default(cuid())
  tableId String

  table Table @relation(fields: [tableId], references: [id])

  status OrderStatus @default(OPEN)

  items OrderItem[]

  subtotal Float @default(0)
  discount Float @default(0)
  total    Float @default(0)

  paymentType String?
  paidAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  quantity Int   @default(1)
  price    Float

  createdAt DateTime @default(now())
}

model PosDevice {
  id String @id @default(cuid())

  name     String
  provider String
  brand    String
  model    String?

  serialNumber String?
  terminalId   String?

  ipAddress String?
  port      Int?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@index([active])
  @@index([provider])
}

model Payment {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  posDeviceId String?
  posDevice   PosDevice? @relation(fields: [posDeviceId], references: [id], onDelete: SetNull)

  amount Float

  method PaymentMethod @default(CARD)
  status PaymentStatus @default(PENDING)

  providerTransactionId String?
  authorizationCode     String?
  referenceNumber       String?

  errorCode    String?
  errorMessage String?

  idempotencyKey String @unique

  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([posDeviceId])
  @@index([status])
  @@index([providerTransactionId])
  @@index([createdAt])
}

enum UserRole {
  OWNER
  MANAGER
  STAFF
}

enum TableStatus {
  EMPTY
  MENU_OPEN
  ORDERED
  PREPARING
  READY
  PAYMENT
  CLOSED
}

enum OrderStatus {
  OPEN
  PREPARING
  READY
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  QR
  TRANSFER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

model Ingredient {
  id          String   @id @default(cuid())
  name        String
  code        String?  @unique
  description String?
  category    String?

  baseUnit StockUnit

  minStock    Float @default(0)
  targetStock Float @default(0)

  currentCostPerBaseUnit Float @default(0)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([category])
}

model Recipe {
  id        String   @id @default(cuid())
  productId String   @unique
  name      String?
  active    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecipeItem {
  id           String @id @default(cuid())
  recipeId     String
  ingredientId String

  quantity Float
  unit     StockUnit

  wastePercent Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([recipeId, ingredientId])
  @@index([recipeId])
  @@index([ingredientId])
}

model StockLocation {
  id     String  @id @default(cuid())
  name   String
  code   String? @unique
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model StockBalance {
  id           String @id @default(cuid())
  ingredientId String
  locationId   String

  quantity Float @default(0)

  updatedAt DateTime @updatedAt

  @@unique([ingredientId, locationId])
  @@index([ingredientId])
  @@index([locationId])
}

model StockMovement {
  id           String @id @default(cuid())
  ingredientId String
  locationId   String

  userId      String?
  orderId     String?
  orderItemId String?

  type StockMovementType

  quantity Float
  unit     StockUnit

  unitCost  Float @default(0)
  totalCost Float @default(0)

  reason String?

  referenceType String?
  referenceId   String?

  createdAt DateTime @default(now())

  @@index([ingredientId, createdAt])
  @@index([locationId, createdAt])
  @@index([type, createdAt])
  @@index([userId])
  @@index([orderId])
  @@index([orderItemId])
}

model Supplier {
  id   String @id @default(cuid())
  name String

  code String? @unique

  phone   String?
  email   String?
  address String?

  taxNumber String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model IngredientSupplier {
  id           String @id @default(cuid())
  ingredientId String
  supplierId   String

  purchaseUnit StockUnit

  packageSize Float @default(1)

  lastPrice    Float @default(0)
  averagePrice Float @default(0)

  minOrderQty Float @default(0)

  supplierCode String?

  isDefault Boolean @default(false)
  active     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ingredientId, supplierId])
  @@index([ingredientId])
  @@index([supplierId])
}

model Purchase {
  id         String @id @default(cuid())
  supplierId String
  userId     String?

  status PurchaseStatus @default(DRAFT)

  invoiceNo String?
  note      String?

  total Float @default(0)

  purchasedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model PurchaseItem {
  id         String @id @default(cuid())
  purchaseId String

  ingredientId String

  quantity Float
  unit     StockUnit

  unitPrice Float
  total     Float

  createdAt DateTime @default(now())

  @@index([purchaseId])
  @@index([ingredientId])
}

model StockCount {
  id         String @id @default(cuid())
  locationId String
  userId     String?

  status StockCountStatus @default(DRAFT)

  note String?

  countedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId])
  @@index([userId])
  @@index([status])
}

model StockCountItem {
  id           String @id @default(cuid())
  stockCountId String
  ingredientId String
  locationId   String

  expectedQty Float @default(0)
  countedQty  Float @default(0)
  difference  Float @default(0)

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([stockCountId, ingredientId])
  @@index([stockCountId])
  @@index([ingredientId])
  @@index([locationId])
}

enum StockUnit {
  G
  KG
  ML
  L
  ADET
  PAKET
  KOLI
}

enum StockMovementType {
  PURCHASE
  SALE_CONSUMPTION
  WASTE
  COUNT_ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN
  MANUAL_IN
  MANUAL_OUT
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum StockCountStatus {
  DRAFT
  COUNTING
  COMPLETED
  CANCELLED
}