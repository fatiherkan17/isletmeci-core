generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url = "file:./dev.db"
}

model Category {
  id String @id @default(cuid())
  name String
  active Boolean @default(true)
  sortOrder Int @default(0)
  icon String?
  products Product[]
}

model Product {
  id String @id @default(cuid())
  name String
  description String?
  price Float
  image String?
  active Boolean @default(true)
  available Boolean @default(true)
  featured Boolean @default(false)
  sortOrder Int @default(0)
  categoryId String
  category Category @relation(fields:[categoryId], references:[id])
}

model Setting {
  id String @id @default(cuid())
  businessName String
  slogan String?
  logo String?
  phone String?
  address String?
  instagram String?
  workingHours String?
}